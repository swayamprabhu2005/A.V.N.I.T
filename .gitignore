# =====================================
# A.V.N.I.T. — Git Ignore Configuration
# =====================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# SQLite Database & Runtime Data
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
*.sqlite3

# Neural Network Checkpoints & Exported Formats
*.pth
*.onnx
*.engine

# Whitelist trained PyTorch models (<50 MB) for direct repository tracking
!backend/models/*.pt
!yolov8n.pt
!backend/models/README.md
!backend/models/.gitkeep

# Node.js & Frontend dependencies
frontend/node_modules/
frontend/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend Build Output
frontend/dist/
frontend/build/

# Local Environment Variables
.env
.env.local
.env.*.local

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Video Uploads & Generated Scenarios Cache
backend/test_samples/*.tmp

# Project Documents & Specifications (Ignored from repository)
*.docx
AVNIT-AI Based Vehicle Number Plate and Identity Tampering Detection Project Details.docx
DATASETS_GUIDE.md
