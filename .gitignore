# =====================================
# A.V.N.I.T. — Git Ignore Configuration
# =====================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# SQLite Database & Runtime Data
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
*.sqlite3

# Neural Network Weights & Checkpoints (Heavy Binaries)
*.pt
*.pth
*.onnx
*.engine
backend/models/*.pt
backend/models/*.pth
backend/models/*.onnx
backend/models/*.engine
!backend/models/README.md
!backend/models/.gitkeep

# Node.js & Frontend dependencies
frontend/node_modules/
frontend/.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Frontend Build Output
frontend/dist/
frontend/build/

# Local Environment Variables
.env
.env.local
.env.*.local

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Video Uploads & Generated Scenarios Cache
backend/test_samples/*.tmp

# Project Documents & Specifications
*.docx
AVNIT-AI Based Vehicle Number Plate and Identity Tampering Detection Project Details.docx

