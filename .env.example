# ========================================================================
# A.V.N.I.T. System Configuration Template (.env.example)
# Copy this file to '.env' (or 'frontend/.env') and supply your keys.
# ========================================================================

# ------------------------------------------------------------------------
# 1. Frontend: Firebase SSO Authentication (Google & Microsoft)
# ------------------------------------------------------------------------
# Obtain these credentials from your Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyDemoKeyReplaceWithYourActualFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=avnit-traffic-security.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=avnit-traffic-security
VITE_FIREBASE_STORAGE_BUCKET=avnit-traffic-security.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------
# 2. Backend Server & Engine Configurations
# ------------------------------------------------------------------------
AVNIT_BACKEND_PORT=8000
AVNIT_FRONTEND_PORT=5173
AVNIT_HOST=0.0.0.0
AVNIT_ENV=production
